# Server
PORT=5000
NODE_ENV=development

# Database (REQUIRED)
MONGODB_URI=mongodb://127.0.0.1:27017/axi_collection

# Auth (REQUIRED) — generate with:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRE=7d

# CORS / URLs
FRONTEND_URL=http://localhost:5173
# Optional comma-separated extra allowed origins (e.g. staging domain)
EXTRA_ALLOWED_ORIGINS=

# Email Service Configuration (Nodemailer SMTP)
# If blank in development, emails are previewed via Ethereal (console preview URLs).
# In PRODUCTION, email sending is DISABLED and failures are logged if this is blank.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="AXI Collection <orders@axicollection.com>"

# Seeding (optional, development only)
# `npm run seed` wipes all users/categories/products and generates a random
# password for each seeded account, printing it to the console once. Set these to
# pin the passwords instead so they survive a re-seed. Must be 8+ characters with
# at least one letter and one digit. Leave blank in any shared environment.
SEED_ADMIN_PASSWORD=
SEED_CUSTOMER_PASSWORD=
