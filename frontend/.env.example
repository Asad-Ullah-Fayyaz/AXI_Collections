# Base URL for the backend API.
#
# DEVELOPMENT: leave this blank. Vite proxies /api and /uploads to
# http://localhost:5000 (see vite.config.js), so the default of "/api" works.
#
# PRODUCTION: set this to the deployed API origin, including the /api path.
#   e.g. VITE_API_URL=https://api.axicollection.com/api
#
# Vite only exposes variables prefixed with VITE_ to client code, and inlines
# them at BUILD time — rebuild after changing this, restarting is not enough.
VITE_API_URL=
