{
  "name": "axi-collection-monorepo",
  "version": "1.0.0",
  "description": "AXI Collection luxury accessories production-ready e-commerce monorepo",
  "private": true,
  "scripts": {
    "start": "node backend/src/server.js",
    "seed": "npm run seed --prefix backend",
